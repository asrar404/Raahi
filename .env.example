# ============================================================
# RAAHI — Environment Configuration
# Copy to .env and fill in real values:  cp .env.example .env
# ============================================================

# ── PostgreSQL + PostGIS ────────────────────────────────────
POSTGRES_USER=raahi
POSTGRES_PASSWORD=raahi_secure_pass
POSTGRES_DB=raahi_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full DSN (asyncpg native format — no SQLAlchemy dialect prefix)
DATABASE_URL=postgresql://raahi:raahi_secure_pass@postgres:5432/raahi_db

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
TELEMETRY_STREAM=raahi:telemetry
TELEMETRY_STREAM_MAXLEN=100000

# ── Supabase Auth ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
# HS256 secret from Supabase dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# ── LLM (Groq) ──────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ── Twilio (SOS SMS + Voice) ────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15551234567
# Set false to log SOS notifications instead of sending them (local dev)
TWILIO_ENABLED=false

# ── Service URLs (internal, docker network) ─────────────────
BACKEND_URL=http://backend:8000
AI_ENGINE_URL=http://ai_engine:8001
SAFETY_WATCHER_URL=http://safety_watcher:8002

# ── Safety tuning ───────────────────────────────────────────
# Risk score (1-5) at or above which SOS escalation begins
RISK_THRESHOLD=3
# Metres off the planned route before deviation is flagged
OFF_ROUTE_THRESHOLD_M=300
# Consecutive off-route readings before reroute is triggered
OFF_ROUTE_STRIKES=3
# Seconds of no movement before STATIONARY state
STATIONARY_THRESHOLD_SECS=300
# Seconds of no movement before a reroute is offered
STATIONARY_REROUTE_SECS=600
POLL_INTERVAL_SECS=15

# ── Expo Mobile (EXPO_PUBLIC_* is exposed to the app bundle) ─
# Use your LAN IP (not localhost) when testing on a physical device
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000
EXPO_PUBLIC_AI_URL=http://localhost:8001
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key

# ── Misc ────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
